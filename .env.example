# ════════════════════════════════════════════
#  Dook-Dak (뚝딱) — 통합 배포 플랫폼
#  환경변수 설정 파일 (.env.example 복사 후 .env로 사용)
# ════════════════════════════════════════════

# ── Database (PostgreSQL) ──────────────────
DATABASE_URL=postgres://dookdak:dookdak_pass@localhost:5432/dookdak
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=5
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

# ── Redis ─────────────────────────────────
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Keycloak (SSO) ────────────────────────
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=infra-platform
KEYCLOAK_CLIENT_ID=dookdak-app
KEYCLOAK_CLIENT_SECRET=change-me-in-production
# Keycloak 그룹 → 역할 매핑 (쉼표 구분)
KEYCLOAK_ADMIN_GROUPS=infra-admin
KEYCLOAK_SENIOR_GROUPS=infra-senior
KEYCLOAK_DEVOPS_GROUPS=infra-devops,sre-team
KEYCLOAK_DEV_GROUPS=developer,backend-team,frontend-team
KEYCLOAK_VIEWER_GROUPS=all-employees

# ── Ansible ───────────────────────────────
ANSIBLE_PLAYBOOK_DIR=/opt/dookdak/playbooks
ANSIBLE_INVENTORY_DIR=/opt/dookdak/inventory
ANSIBLE_RUNNER_PATH=/usr/local/bin/ansible-runner
ANSIBLE_RUNNER_ARTIFACTS_DIR=/var/lib/dookdak/artifacts
# ansible-runner 최대 동시 실행 수 (per worker)
ANSIBLE_MAX_CONCURRENT_JOBS=5
ANSIBLE_DEFAULT_FORKS=50
ANSIBLE_JOB_TIMEOUT_SECONDS=3600

# ── Temporal (Workflow Engine) ─────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=dookdak
TEMPORAL_TASK_QUEUE=dookdak-workflows

# ── Server ────────────────────────────────
API_PORT=8080
LOG_LEVEL=debug     # debug | info | warn | error
ENVIRONMENT=development   # development | production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
WS_MAX_CONNECTIONS=1000
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024

# ── Notifications ─────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# Slack 채널별 설정 (없으면 기본 webhook 사용)
SLACK_CHANNEL_SUCCESS=#infra-deploy-success
SLACK_CHANNEL_FAILURE=#infra-deploy-alert
SLACK_CHANNEL_APPROVAL=#infra-deploy-approval
SLACK_CHANNEL_OPS=#infra-ops-alert

PAGERDUTY_ROUTING_KEY=
PAGERDUTY_FROM_EMAIL=infra@company.com

EMAIL_SMTP_HOST=smtp.company.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=noreply@company.com
EMAIL_PASSWORD=
EMAIL_FROM=Dook-Dak <noreply@company.com>
EMAIL_TO=sr.infra@company.com,ops-team@company.com

# ── GitHub Ansible Repo Sync ──────────────
# Ansible 플레이북 GitHub 저장소 자동 동기화
GITHUB_REPO_URL=https://github.com/your-org/ansible-playbooks.git
GITHUB_BRANCH=main
# Private 저장소인 경우 Personal Access Token (repo 스코프)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# 폴링 간격 (초). 0으로 설정 시 폴링 비활성화 (webhook만 사용)
GITHUB_SYNC_INTERVAL_SECONDS=60
# GitHub Webhook Secret (Settings > Webhooks > Secret)
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret
# 로컬 체크아웃 디렉토리 (기본값: ANSIBLE_PLAYBOOK_DIR)
GITHUB_LOCAL_DIR=

# ── CMDB Sync ─────────────────────────────
CMDB_API_URL=http://cmdb.internal/api/v1
CMDB_API_TOKEN=
CMDB_SYNC_INTERVAL_SECONDS=300
CMDB_SYNC_TIMEOUT_SECONDS=60
# 동기화 실패 시 이전 캐시 유지 여부
CMDB_USE_CACHE_ON_FAILURE=true

# ── Frontend (Vite 환경변수, VITE_ 접두사 필수) ──
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=infra-platform
VITE_KEYCLOAK_CLIENT_ID=dookdak-app
VITE_APP_VERSION=0.1.0
VITE_ENABLE_MOCK_AUTH=false   # 개발시 Keycloak 없이 동작

# ── Security ──────────────────────────────
JWT_ISSUER=http://localhost:8180/realms/infra-platform
# SSH 키 경로 (Ansible이 사용)
ANSIBLE_SSH_PRIVATE_KEY_FILE=/home/ansible/.ssh/id_rsa
ANSIBLE_SSH_USER=ansible
ANSIBLE_BECOME_METHOD=sudo
